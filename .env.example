# ── 必须配置 ──
PG_PASSWORD=            # PostgreSQL 密码（必填）

# LLM API（HyperFrames 使用）
HYPERFRAMES_API_KEY=     # LLM API 密钥
HYPERFRAMES_BASE_URL=    # LLM API 地址（默认 OpenAI）

# 飞书多维表格用户认证（如需用户系统）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=

# ── 可选配置 ──
HYPERFRAMES_VERSION=0.6.6
PUBLIC_URL=http://localhost
ALLOW_ORIGINS=*
PORT=80                  # 对外监听端口
MAX_CONCURRENT=2         # Worker 并行任务数
TASK_TIMEOUT=600         # 单个任务超时（秒）
MAX_FILE_SIZE_MB=50
MAX_TASKS_GLOBAL=100

# SMTP（验证码邮件）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
